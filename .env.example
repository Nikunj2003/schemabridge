# Copy to .env.local and fill in. Never commit real values.

# --- Inference (server-only) ---------------------------------------------
# Create a key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Open-weights model (Apache-2.0). Measured: ~11s for a schema-constrained
# reply at low reasoning effort. Any OpenAI-compatible model works here.
NVIDIA_MODEL=openai/gpt-oss-20b
MODEL_TIMEOUT_SECONDS=45

# --- Persistence (server-only) -------------------------------------------
# Use a least-privilege user scoped to this database, not an Atlas admin.
# Include the database name in the path: ...mongodb.net/schemabridge?...
MONGODB_URI=
MONGODB_DB=schemabridge

# --- Destination connector (server-only) ---------------------------------
# Shared secret the migration engine sends to the in-app stub API.
TARGET_API_SECRET=
# Absolute origin for outbound calls. Leave blank locally.
TARGET_API_ORIGIN=

# --- Demo safety budgets -------------------------------------------------
# Upper bound on upstream model requests for a single migration run.
AI_MAX_REQUESTS_PER_RUN=3
# Upper bound per rolling day across all visitors, so one person cannot
# exhaust the shared free-tier allowance.
AI_MAX_REQUESTS_PER_DAY=400
# Migration starts available to one anonymous browser session each India calendar day.
MIGRATION_MAX_RUNS_PER_DAY=10

# --- Runtime -------------------------------------------------------------
# Wall-clock budget for one processing step. Kept below the platform's
# 300s function ceiling so a step checkpoints instead of being killed.
ADVANCE_BUDGET_SECONDS=120
RUN_TTL_HOURS=48
