# Copy to .env.local and fill in. Never commit real values.

# --- Inference (server-only) ---------------------------------------------
# Create a key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Open-weights model (Apache-2.0). Measured: ~11s for a schema-constrained
# reply at low reasoning effort. Any OpenAI-compatible model works here.
NVIDIA_MODEL=openai/gpt-oss-20b
MODEL_TIMEOUT_SECONDS=45

# --- Persistence (server-only) -------------------------------------------
# Use a least-privilege user scoped to this database, not an Atlas admin.
# Include the database name in the path: ...mongodb.net/schemabridge?...
MONGODB_URI=
MONGODB_DB=schemabridge

# --- Destination connector (server-only) ---------------------------------
# Shared secret the migration engine sends to the in-app stub API.
TARGET_API_SECRET=
# Absolute origin for outbound calls. Leave blank locally.
TARGET_API_ORIGIN=

# --- Auth0 (server-only) -------------------------------------------------
# Auth0 validates access tokens here. Set these to the tenant issuer and API
# identifier after creating the SchemaBridge SPA/API; do not put a client secret here.
AUTH0_ISSUER=
AUTH0_AUDIENCE=https://api.schemabridge.app
AUTH0_JWKS_CACHE_SECONDS=3600

# --- Frontend Auth0 configuration ----------------------------------------
# Put these non-secret values in frontend/.env.local for local development,
# or set them in the frontend deployment environment BEFORE building. Next.js
# embeds NEXT_PUBLIC_* values into the browser bundle at build time.
# NEXT_PUBLIC_AUTH0_DOMAIN=YOUR_TENANT_REGION.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID
# NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.schemabridge.app

# --- Demo safety budgets -------------------------------------------------
AI_MAX_REQUESTS_PER_RUN=6
AI_MAX_REQUESTS_PER_DAY=400
# Authenticated users receive separate daily allowances; guests share one.
AUTHENTICATED_MIGRATION_MAX_RUNS_PER_DAY=20
ANONYMOUS_MIGRATION_MAX_RUNS_PER_DAY=100
# NVIDIA's shared endpoint allowance. Calls are globally spaced and transient
# provider errors are retried without charging an extra logical run request.
NVIDIA_REQUESTS_PER_MINUTE=45
NVIDIA_RETRY_ATTEMPTS=3
NVIDIA_MAX_QUEUE_SECONDS=45

# --- Retention and operator observability --------------------------------
AUTHENTICATED_RETENTION_HOURS=168
ANONYMOUS_RETENTION_HOURS=48
# A separate bearer-style secret for /api/observability. Keep it server-only.
OBSERVABILITY_API_SECRET=
# Disabled by default. Enable only with credentials and deliberate content policy.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

# --- Runtime -------------------------------------------------------------
ADVANCE_BUDGET_SECONDS=120
# Legacy checkpointer expiry for runs created before workspace retention exists.
RUN_TTL_HOURS=48
